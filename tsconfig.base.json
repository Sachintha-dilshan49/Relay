{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@relay/shared-types": ["./packages/shared-types/src"],
      "@relay/shared-utils": ["./packages/shared-utils/src"],
      "@relay/database": ["./packages/database/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

# ─────────────────────────────────────────────────────────────────────────────
# Relay — webhook-worker Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://relay_user:relay_pass@localhost:5432/relay_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker settings
WORKER_CONCURRENCY=5

# Webhook settings
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3
